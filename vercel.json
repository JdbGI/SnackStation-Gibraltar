{
    "version": 2,
    "builds": [
        {
            "src": "api/index.ts",
            "use": "@vercel/node"
        },
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist/public"
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "has": [{ "type": "host", "value": "snack-station-gibraltar.vercel.app" }],
            "headers": { "X-Robots-Tag": "noindex, nofollow" },
            "continue": true
        },
        {
            "src": "/(.+)/",
            "status": 308,
            "headers": { "Location": "/$1" }
        },
        {
            "src": "/api/(.*)",
            "dest": "/api/index.ts"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(auth|dashboard|admin|catalogue)(/.*)?",
            "dest": "/index.html"
        },
        {
            "src": "/(.*)",
            "status": 404,
            "dest": "/404.html"
        }
    ]
}